{
  "name": "insane",
  "version": "0.9.0-dev",
  "private": true,
  "description": "INSANE: the barter-and-dare app for the five people you actually see. One-file artifact built from src/.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "node tools/build.js",
    "check": "node tools/build.js --check",
    "test": "node test/run.js",
    "test:quick": "node test/run.js build unit pbt diff",
    "test:e2e": "node test/run.js e2e:local e2e:server e2e:map",
    "golden:update": "GOLDEN_UPDATE=1 node test/run.js golden",
    "start": "node server/server.js"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
